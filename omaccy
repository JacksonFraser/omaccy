#!/usr/bin/env python3
"""omaccy — a Maccy-style clipboard history for Omarchy (Hyprland).

  omaccy            start the background daemon (records clipboard history)
  omaccy toggle     show / hide the popup (starts the daemon if needed)
  omaccy show       show the popup
  omaccy settings   open the settings window
  omaccy quit       stop the daemon
"""

