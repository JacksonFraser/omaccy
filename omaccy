# --------------------------------------------------------------- settings ---

class Settings:
    DEFAULTS = {
        "history_size": 200,           # unpinned items kept
        "paste_automatically": True,   # Enter pastes; Shift+Enter does the opposite
        "pinned_position": "top",      # "top" or "bottom"
        "show_preview": True,
        "preview_delay": 600,          # ms the selection must rest before previewing
        "save_images": True,
    }

    def __init__(self, path):
        self.path = path
        self.values = dict(self.DEFAULTS)
        try:
            with open(path, "rb") as f:
                loaded = tomllib.load(f)
            for key, default in self.DEFAULTS.items():
                if isinstance(loaded.get(key), type(default)):
                    self.values[key] = loaded[key]
        except (OSError, ValueError):
            pass

    def __getattr__(self, key):
        try:
            return self.__dict__["values"][key]
        except KeyError:
            raise AttributeError(key) from None

    def set(self, key, value):
        self.values[key] = value
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
        lines = ["# omaccy settings (also editable from the Settings window)"]
        for k, v in self.values.items():
            lines.append(f"{k} = {str(v).lower() if isinstance(v, bool) else json.dumps(v)}")
        with open(self.path, "w") as f:
            f.write("\n".join(lines) + "\n")


# ---------------------------------------------------------------- storage ---

class Store:
    def __init__(self, path, settings):
        self.path = path
        self.settings = settings
        self.items = []
        self.load()

    def load(self):
        try:
            with open(self.path) as f:
                self.items = json.load(f).get("items", [])
        except (OSError, ValueError):
            self.items = []
        for item in self.items:
            self._index(item)

    @staticmethod
    def _index(item):
        if item.get("type") == "image":
            item["_fold"] = f"image {item.get('width', 0)}x{item.get('height', 0)} {item.get('app', '')}".casefold()
        else:
            item["_fold"] = item["text"].casefold()

    def save(self):
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
        tmp = self.path + ".tmp"
        data = {"items": [{k: v for k, v in i.items() if not k.startswith("_")} for i in self.items]}
        with open(tmp, "w") as f:
            json.dump(data, f, ensure_ascii=False)
        os.replace(tmp, self.path)

    def _bump_or_insert(self, existing, new, app):
        now = time.time()
        if existing:
            self.items.remove(existing)
            existing["count"] = existing.get("count", 1) + 1
            existing["last"] = now
            item = existing
        else:
            item = dict(new, count=1, first=now, last=now, pinned=False)
            if app:
                item["app"] = app
            self._index(item)
        self.items.insert(0, item)
        self.trim()
        self.save()

    def add_text(self, text, app=None):
        existing = next((i for i in self.items if i.get("text") == text), None)
        self._bump_or_insert(existing, {"type": "text", "text": text}, app)

    def add_image(self, data, mime, app=None):
        name = hashlib.sha256(data).hexdigest()[:32] + "." + IMAGE_MIMES[mime]
        path = os.path.join(IMAGE_DIR, name)
        if not os.path.exists(path):
            os.makedirs(IMAGE_DIR, exist_ok=True)
            with open(path + ".tmp", "wb") as f:
                f.write(data)
            os.replace(path + ".tmp", path)
        info = GdkPixbuf.Pixbuf.get_file_info(path)
        if info is None or info[0] is None:
            os.remove(path)
            return
        existing = next((i for i in self.items if i.get("image") == name), None)
        self._bump_or_insert(existing, {"type": "image", "image": name, "mime": mime,
                                        "width": info[1], "height": info[2]}, app)

    def _drop(self, item):
        self.items.remove(item)
        if item.get("type") == "image":
            try:
                os.remove(os.path.join(IMAGE_DIR, item["image"]))
            except OSError:
                pass

    def trim(self):
        unpinned = [i for i in self.items if not i.get("pinned")]
        for stale in unpinned[self.settings.history_size:]:
            self._drop(stale)

    def pinned(self):
        return sorted((i for i in self.items if i.get("pinned")), key=lambda i: i.get("pinned_at", 0))

    def history(self):
        return [i for i in self.items if not i.get("pinned")]

    def toggle_pin(self, item):
        if item.get("pinned"):
            item["pinned"] = False
            item.pop("pin_key", None)
            item.pop("pinned_at", None)
        else:
            used = {i.get("pin_key") for i in self.items if i.get("pinned")}
            item["pinned"] = True
            item["pinned_at"] = time.time()
            item["pin_key"] = next((k for k in PIN_KEYS if k not in used), None)
        self.trim()
        self.save()

    def remove(self, item):
        if item in self.items:
            self._drop(item)
            self.save()

    def clear(self):
        for item in self.history():
            self._drop(item)
        self.save()


# ------------------------------------------------------------------ theme ---
#
# Everything is derived from the current Omarchy theme's colors.toml, and made
# robust for any theme: missing keys are computed, low-contrast pairs are
# corrected, and light themes get lighter shadows.

def _parse(color, fallback):
    h = str(color or "").strip().lstrip("#")
    if len(h) in (3, 4):
        h = "".join(c * 2 for c in h[:3])
    try:
        return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))
    except ValueError:
        return fallback


def _hex(rgb):
    return "#%02x%02x%02x" % tuple(max(0, min(255, round(c))) for c in rgb)


def _rgba(rgb, alpha):
    return "rgba(%d,%d,%d,%s)" % (*(round(c) for c in rgb), alpha)


def _mix(a, b, t):
    """t=0 gives a, t=1 gives b."""
    return tuple(x + (y - x) * t for x, y in zip(a, b))


def _luminance(rgb):
    def channel(c):
        c /= 255
        return c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4
    r, g, b = (channel(c) for c in rgb)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def _contrast(a, b):
    la, lb = sorted((_luminance(a), _luminance(b)), reverse=True)
    return (la + 0.05) / (lb + 0.05)


def _readable(on, bg, fg, minimum):
    """Nudge `on` towards fg until it reaches `minimum` contrast against bg."""
    for step in range(11):
        candidate = _mix(on, fg, step / 10)
        if _contrast(candidate, bg) >= minimum:
            return candidate
    return fg


def load_palette(path):
    try:
        with open(path, "rb") as f:
            raw = {k: v for k, v in tomllib.load(f).items() if isinstance(v, str)}
    except (OSError, ValueError):
        raw = {}

    bg = _parse(raw.get("background"), (28, 28, 30))
    fg = _parse(raw.get("foreground"), (242, 242, 242))
    if _contrast(fg, bg) < 4.5:  # broken theme: fall back to black/white text
        fg = max(((0, 0, 0), (255, 255, 255)), key=lambda c: _contrast(c, bg))
    mode = raw.get("mode")
    dark = mode != "light" if mode in ("light", "dark") else _luminance(bg) < 0.4

    # Selection colour: the theme accent, unless it vanishes into the background.
    accent = _parse(raw.get("accent") or raw.get("blue"), fg)
    if _contrast(accent, bg) < 1.8:
        accent = _mix(bg, fg, 0.6)
    # Text on the selection: whichever of the theme's own colours reads best.
    on_accent = max((bg, fg), key=lambda c: _contrast(c, accent))
    if _contrast(on_accent, accent) < 4.5:
        on_accent = max(((0, 0, 0), (255, 255, 255)), key=lambda c: _contrast(c, accent))

    muted = _parse(raw.get("muted") or raw.get("dark_foreground"), _mix(fg, bg, 0.45))
    muted = _readable(muted, bg, fg, 3.0)

    return {
        "dark": dark,
        "bg": bg,
        "fg": fg,
        "accent": accent,
        "on_accent": on_accent,
        "muted": muted,
        # Pinned-icon colour on the plain card: accent if it reads, else fg.
        "accent_text": accent if _contrast(accent, bg) >= 3.0 else fg,
        "raised": _mix(bg, fg, 0.06 if dark else 0.04),
    }


