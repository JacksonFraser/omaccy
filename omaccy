class Theme:
    """Keeps one CSS provider in sync with the current Omarchy theme."""

    def __init__(self, path=THEME_COLORS):
        self.path = path
        self.provider = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), self.provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.stamp = None
        # `omarchy theme set` rewrites the current theme directory; follow it
        # live so open windows restyle immediately.
        current = Gio.File.new_for_path(os.path.dirname(os.path.dirname(path)))
        self.monitor = current.monitor_directory(Gio.FileMonitorFlags.WATCH_MOVES, None)
        self.monitor.connect("changed", lambda *_: GLib.timeout_add(300, lambda: self.apply() and False))

    def apply(self):
        try:
            st = os.stat(self.path)
            stamp = (st.st_mtime_ns, st.st_ino, st.st_size)
        except OSError:
            stamp = None
        if stamp == self.stamp and stamp is not None:
            return
        self.stamp = stamp
        palette = load_palette(self.path)
        # The system GTK theme may be a fixed dark variant; use plain Adwaita
        # in the theme's own mode so unstyled bits match light themes too.
        gtk_settings = Gtk.Settings.get_default()
        gtk_settings.set_property("gtk-theme-name", "Adwaita")
        gtk_settings.set_property("gtk-application-prefer-dark-theme", palette["dark"])
        self.provider.load_from_string(build_css(palette))


# --------------------------------------------------------------- helpers ---

def one_line(text, limit=300):
    return " ".join(text[: limit * 4].split())[:limit] or "(whitespace)"


def highlight(display, terms):
    """Return Pango markup for display with every term occurrence in bold."""
    if not terms:
        return escape(display)
    folded = display.casefold()
    if len(folded) != len(display):
        return escape(display)
    spans = []
    for term in terms:
        for m in re.finditer(re.escape(term), folded):
            spans.append((m.start(), m.end()))
    if not spans:
        return escape(display)
    spans.sort()
    merged = [list(spans[0])]
    for s, e in spans[1:]:
        if s <= merged[-1][1]:
            merged[-1][1] = max(merged[-1][1], e)
        else:
            merged.append([s, e])
    out, pos = [], 0
    for s, e in merged:
        out.append(escape(display[pos:s]))
        out.append(f"<b>{escape(display[s:e])}</b>")
        pos = e
    out.append(escape(display[pos:]))
    return "".join(out)


def ago(ts):
    delta = max(0, time.time() - ts)
    for unit, secs in (("day", 86400), ("hour", 3600), ("minute", 60)):
        if delta >= secs:
            n = int(delta // secs)
            return f"{n} {unit}{'s' if n != 1 else ''} ago"
    return "just now"


def when(ts):
    return f"{time.strftime('%a %d %b, %H:%M', time.localtime(ts))} ({ago(ts)})"


def image_path(item):
    return os.path.join(IMAGE_DIR, item["image"])


_thumbs = {}


def thumbnail(item, scale):
    """A small texture for list rows, cached per image and output scale."""
    key = (item["image"], scale)
    if key not in _thumbs:
        try:
            pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(
                image_path(item), THUMB_WIDTH * scale, THUMB_HEIGHT * scale, True)
            fmt = Gdk.MemoryFormat.R8G8B8A8 if pixbuf.get_has_alpha() else Gdk.MemoryFormat.R8G8B8
            _thumbs[key] = Gdk.MemoryTexture.new(pixbuf.get_width(), pixbuf.get_height(), fmt,
                                                 pixbuf.read_pixel_bytes(), pixbuf.get_rowstride())
        except GLib.Error:
            _thumbs[key] = None
    return _thumbs[key]


class SizedPicture(Gtk.Picture):
    """A picture drawn at an exact logical size.

    Gtk.Picture asks for the texture's pixel size, which on a scaled display
    makes images far bigger than intended; this pins the size instead.
    """

    def __init__(self, paintable, width, height, **kwargs):
        super().__init__(paintable=paintable, can_shrink=True, content_fit=Gtk.ContentFit.CONTAIN,
                         hexpand=False, vexpand=False, valign=Gtk.Align.CENTER, **kwargs)
        self.size = (width, height)

    def do_measure(self, orientation, _for_size):
        n = self.size[0] if orientation == Gtk.Orientation.HORIZONTAL else self.size[1]
        return n, n, -1, -1


def fit(width, height, max_w, max_h):
    ratio = min(max_w / max(width, 1), max_h / max(height, 1), 1.0)
    return max(1, int(width * ratio)), max(1, int(height * ratio))


def run_async(argv, done):
    """Run argv, then call done(stdout bytes) on success or done(None)."""
    try:
        proc = Gio.Subprocess.new(argv, Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE)
    except GLib.Error:
        done(None)
        return

    def finished(p, result):
        try:
            _ok, out, _err = p.communicate_finish(result)
        except GLib.Error:
            done(None)
            return
        ok = p.get_if_exited() and p.get_exit_status() == 0 and out is not None
        done(out.get_data() if ok else None)

    proc.communicate_async(None, None, finished)


def _point(x, y):
    p = Graphene.Point()
    p.x, p.y = x, y
    return p


# ----------------------------------------------------------------- popup ---

class Popup(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app)
        self.app = app
        self.store = app.store
        self.settings = app.settings
        self.rows = []
        self.sel = -1
        self.last_pointer = None
        self.preview_timer = 0
        self.preview_shown = False
        self.add_css_class("omaccy")

        LayerShell.init_for_window(self)
        LayerShell.set_namespace(self, "omaccy")
        LayerShell.set_layer(self, LayerShell.Layer.OVERLAY)
        LayerShell.set_keyboard_mode(self, LayerShell.KeyboardMode.EXCLUSIVE)
        LayerShell.set_exclusive_zone(self, -1)
        for edge in (LayerShell.Edge.TOP, LayerShell.Edge.BOTTOM, LayerShell.Edge.LEFT, LayerShell.Edge.RIGHT):
            LayerShell.set_anchor(self, edge, True)

        # Full-screen transparent surface; clicking outside the cards closes it.
        self.backdrop = Gtk.Box(hexpand=True, vexpand=True)
        backdrop_click = Gtk.GestureClick()
        backdrop_click.connect("pressed", self.on_backdrop_click)
        self.backdrop.add_controller(backdrop_click)
        self.set_child(self.backdrop)

        # [spacer][card][preview]: the spacer mirrors the preview so the card
        # stays centred and nothing moves when the preview appears.
        self.stage = Gtk.Box(spacing=10, halign=Gtk.Align.CENTER, valign=Gtk.Align.START, hexpand=True)
        self.backdrop.append(self.stage)
        self.stage.append(Gtk.Box(width_request=PREVIEW_WIDTH))

        self.card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.START, width_request=CARD_WIDTH)
        self.card.add_css_class("card")
        self.stage.append(self.card)

        self.preview = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.START,
                               width_request=PREVIEW_WIDTH, spacing=12)
        self.preview.add_css_class("card")
        self.preview.add_css_class("preview")
        self.stage.append(self.preview)
        self._set_preview_visible(False)

        header = Gtk.Box(spacing=10)
        header.add_css_class("header")
        header.append(Gtk.Image.new_from_icon_name("system-search-symbolic"))
        self.search = Gtk.Text(hexpand=True, placeholder_text="Type to search…")
        self.search.add_css_class("search")
        self.search.connect("changed", lambda *_: self.refresh())
        header.append(self.search)
        self.card.append(header)
        self.card.append(self._divider())

        self.listbox = Gtk.ListBox(selection_mode=Gtk.SelectionMode.BROWSE)
        self.listbox.add_css_class("items")
        self.listbox.set_header_func(self._section_header)
        self.listbox.connect("row-activated", lambda _lb, row: self.choose(row.item))
        self.scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER,
                                           propagate_natural_height=True, max_content_height=460)
        self.scroller.set_child(self.listbox)
        motion = Gtk.EventControllerMotion()
        motion.connect("motion", self.on_pointer_motion)
        self.scroller.add_controller(motion)
        self.card.append(self.scroller)

        self.empty = Gtk.Label()
        self.empty.add_css_class("empty")
        self.card.append(self.empty)

        self.card.append(self._divider())
        footer = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        footer.add_css_class("footer")
        self.footer_rows = [
            self._menu_row("Clear", "Ctrl+Shift+⌫", self.clear_history),
            self._menu_row("Settings…", "Ctrl+,", self.open_settings),
            self._menu_row("Quit", "Ctrl+Q", app.quit),
        ]
        for row in self.footer_rows:
            footer.append(row)
        footer.connect("row-activated", lambda _lb, row: row.action())
        self.card.append(footer)
        self.footer_sel = -1  # >= 0 while Tab has moved keyboard focus to the footer

        keys = Gtk.EventControllerKey(propagation_phase=Gtk.PropagationPhase.CAPTURE)
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)
        self.connect("map", self.on_map)

    # -- building -----------------------------------------------------------

    def _divider(self):
        sep = Gtk.Separator()
        sep.add_css_class("divider")
        return sep

    def _menu_row(self, title, shortcut, action):
        row = Gtk.ListBoxRow()
        box = Gtk.Box()
        box.append(Gtk.Label(label=title, hexpand=True, xalign=0))
        hint = Gtk.Label(label=shortcut)
        hint.add_css_class("shortcut")
        box.append(hint)
        row.set_child(box)
        row.action = action
        return row

    def _section_header(self, row, before):
        if before is not None and bool(before.item.get("pinned")) != bool(row.item.get("pinned")):
            sep = Gtk.Separator()
            sep.add_css_class("section")
            row.set_header(sep)
        else:
            row.set_header(None)

    def _item_row(self, item, shortcut, terms):
        row = Gtk.ListBoxRow()
        row.item = item
        box = Gtk.Box()

        if item.get("type") == "image":
            texture = thumbnail(item, max(1, self.get_scale_factor()))
            if texture:
                w, h = fit(item.get("width", 1), item.get("height", 1), THUMB_WIDTH, THUMB_HEIGHT)
                pic = SizedPicture(texture, w, h, halign=Gtk.Align.START)
                pic.add_css_class("thumb")
                pic.set_overflow(Gtk.Overflow.HIDDEN)
                box.append(pic)
            label = Gtk.Label(xalign=0, hexpand=True, label=f"{item.get('width')}×{item.get('height')}")
            label.add_css_class("dim")
        else:
            label = Gtk.Label(xalign=0, hexpand=True, ellipsize=Pango.EllipsizeMode.END, single_line_mode=True)
            label.set_markup(highlight(one_line(item["text"]), terms))
        box.append(label)

        pinned = item.get("pinned")
        pin = Gtk.Button(icon_name="view-pin-symbolic", focusable=False, valign=Gtk.Align.CENTER,
                         tooltip_text="Unpin (Alt+P)" if pinned else "Pin (Alt+P)")
        pin.add_css_class("pin")
        if pinned:
            pin.add_css_class("pinned")
        pin.connect("clicked", lambda *_: self.toggle_pin(item))
        box.append(pin)

        hint = Gtk.Label(label=shortcut or "", width_chars=6, xalign=1)
        hint.add_css_class("shortcut")
        box.append(hint)
        row.set_child(box)
        return row

    def refresh(self, keep_item=None):
        query = self.search.get_text().strip().casefold()
        terms = query.split()

        def matches(item):
            return all(t in item["_fold"] for t in terms)

        pinned = [i for i in self.store.pinned() if matches(i)]
        history = [i for i in self.store.history() if matches(i)]

        pinned_rows = []
        for item in pinned:
            key = item.get("pin_key")
            pinned_rows.append(self._item_row(item, f"Alt+{key.upper()}" if key else None, terms))
        history_rows = [self._item_row(item, f"Ctrl+{n + 1}" if n < 9 else None, terms)
                        for n, item in enumerate(history)]
        pinned_first = self.settings.pinned_position != "bottom"
        self.rows = pinned_rows + history_rows if pinned_first else history_rows + pinned_rows

        self.listbox.remove_all()
        for row in self.rows:
            self.listbox.append(row)

        self.scroller.set_visible(bool(self.rows))
        self.empty.set_visible(not self.rows)
        self.empty.set_label("No matches" if terms else "Copy something to get started")

        # Keep the same item selected across rebuilds, otherwise select the
        # most recent copy (or the best match while searching).
        index = next((n for n, r in enumerate(self.rows) if r.item is keep_item), None)
        if index is None:
            first_history = len(pinned_rows) if pinned_first else 0
            index = 0 if terms or not history_rows else first_history
        self.select(index)

    def select(self, index):
        if not self.rows:
            self.sel = -1
            self.schedule_preview()
            return
        self.sel = max(0, min(index, len(self.rows) - 1))
        row = self.rows[self.sel]
        self.listbox.select_row(row)
        GLib.idle_add(self._scroll_to, row)
        self.schedule_preview()

    def _scroll_to(self, row):
        ok, bounds = row.compute_bounds(self.listbox)
        if not ok:
            return False
        y, h = bounds.origin.y, bounds.size.height
        adj = self.scroller.get_vadjustment()
        if y < adj.get_value():
            adj.set_value(y)
        elif y + h > adj.get_value() + adj.get_page_size():
            adj.set_value(y + h - adj.get_page_size())
        return False

    def selected_item(self):
        return self.rows[self.sel].item if 0 <= self.sel < len(self.rows) else None

    # -- preview ------------------------------------------------------------

    def _set_preview_visible(self, visible):
        self.preview_shown = visible
        self.preview.set_opacity(1 if visible else 0)
        self.preview.set_can_target(visible)

    def schedule_preview(self):
        if self.preview_timer:
            GLib.source_remove(self.preview_timer)
            self.preview_timer = 0
        item = self.selected_item()
        if not item or not self.settings.show_preview:
            self._set_preview_visible(False)
        elif self.preview_shown:
            self.fill_preview(item)  # already showing: follow the selection
        else:
            self.preview_timer = GLib.timeout_add(max(0, self.settings.preview_delay), self._show_preview)

    def _show_preview(self):
        self.preview_timer = 0
        item = self.selected_item()
        if item and self.get_visible():
            self.fill_preview(item)
            self._set_preview_visible(True)
        return False

    def fill_preview(self, item):
        while child := self.preview.get_first_child():
            self.preview.remove(child)

        if item.get("type") == "image":
            w, h = fit(item.get("width", 1), item.get("height", 1), PREVIEW_IMAGE_WIDTH, PREVIEW_IMAGE_HEIGHT)
            try:
                texture = Gdk.Texture.new_from_filename(image_path(item))
                self.preview.append(SizedPicture(texture, w, h, halign=Gtk.Align.CENTER))
            except GLib.Error:
                self.preview.append(Gtk.Label(label="(image missing)", xalign=0))
        else:
            text = item["text"]
            shown = text if len(text) <= 5000 else text[:5000] + "\n…"
            body = Gtk.Label(label=shown, xalign=0, yalign=0, wrap=True,
                             wrap_mode=Pango.WrapMode.WORD_CHAR, selectable=False)
            body.add_css_class("body")
            scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER,
                                        propagate_natural_height=True, max_content_height=340)
            scroll.set_child(body)
            self.preview.append(scroll)

        self.preview.append(self._divider())
        grid = Gtk.Grid(column_spacing=14, row_spacing=3)
        facts = []
        if item.get("type") == "image":
            facts.append(("Size", f"{item.get('width')}×{item.get('height')} {item.get('mime', '')}"))
        else:
            text = item["text"]
            facts.append(("Length", f"{len(text):,} characters, {text.count(chr(10)) + 1:,} lines"))
        if item.get("app"):
            facts.append(("Copied from", item["app"]))
        facts.append(("First copied", when(item.get("first", 0))))
        facts.append(("Last copied", when(item.get("last", 0))))
        facts.append(("Copies", str(item.get("count", 1))))
        for n, (key, value) in enumerate(facts):
            k = Gtk.Label(label=key, xalign=0)
            k.add_css_class("meta-key")
            v = Gtk.Label(label=value, xalign=0, ellipsize=Pango.EllipsizeMode.END, hexpand=True)
            v.add_css_class("meta-value")
            grid.attach(k, 0, n, 1, 1)
            grid.attach(v, 1, n, 1, 1)
        self.preview.append(grid)

        pin_word = "unpin" if item.get("pinned") else "pin"
        hints = Gtk.Label(label=f"Alt+P to {pin_word} · Alt+Delete to remove", xalign=0)
        hints.add_css_class("meta")
        self.preview.append(hints)

    # -- show / hide --------------------------------------------------------

    def focus_footer(self, index):
        index = max(0, min(index, len(self.footer_rows) - 1))
        if self.footer_sel >= 0:
            self.footer_rows[self.footer_sel].remove_css_class("kbd")
        self.footer_sel = index
        self.footer_rows[index].add_css_class("kbd")
        self.listbox.add_css_class("inactive")

    def leave_footer(self):
        if self.footer_sel >= 0:
            self.footer_rows[self.footer_sel].remove_css_class("kbd")
        self.footer_sel = -1
        self.listbox.remove_css_class("inactive")

    def open(self):
        self.leave_footer()
        self.app.theme.apply()
        self._set_preview_visible(False)
        self.search.set_text("")
        self.refresh()
        self.last_pointer = None
        self.present()
        self.search.grab_focus()

    def close_popup(self):
        if self.preview_timer:
            GLib.source_remove(self.preview_timer)
            self.preview_timer = 0
        self._set_preview_visible(False)
        self.set_visible(False)

    def toggle(self):
        if self.get_visible():
            self.close_popup()
        else:
            self.open()

    def on_map(self, *_):
        # Place the cards a little above centre on whichever monitor we landed on.
        monitor = self.get_display().get_monitor_at_surface(self.get_surface())
        if monitor:
            self.stage.set_margin_top(int(monitor.get_geometry().height * 0.14))

    # -- actions ------------------------------------------------------------

    def choose(self, item, invert=False):
        if not item:
            return
        self.close_popup()
        try:
            if item.get("type") == "image":
                with open(image_path(item), "rb") as f:
                    subprocess.run(["wl-copy", "--type", item.get("mime", "image/png")], stdin=f, timeout=3)
            else:
                subprocess.run(["wl-copy"], input=item["text"].encode(), timeout=3)
        except (OSError, subprocess.SubprocessError):
            return
        if self.settings.paste_automatically != invert:
            # Give Hyprland a moment to hand focus back to the previous window.
            GLib.timeout_add(150, self._paste)

    def _paste(self):
        subprocess.Popen(["wtype", "-M", "shift", "-k", "Insert", "-m", "shift"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return False

    def toggle_pin(self, item):
        if item:
            self.store.toggle_pin(item)
            self.refresh(keep_item=item)

    def remove(self, item):
        if item:
            index = self.sel
            self.store.remove(item)
            self.refresh()
            self.select(index)

    def clear_history(self):
        self.store.clear()
        self.refresh()

    def open_settings(self):
        self.close_popup()
        self.app.open_settings(from_popup=True)

    # -- input --------------------------------------------------------------

    def on_backdrop_click(self, _gesture, _n, x, y):
        widget = self.backdrop.pick(x, y, Gtk.PickFlags.DEFAULT)
        while widget is not None:
            if widget is self.card or (widget is self.preview and self.preview_shown):
                return
            widget = widget.get_parent()
        self.close_popup()

    def on_pointer_motion(self, _ctrl, x, y):
        # Follow the pointer like a menu, but only when it really moves (not
        # when the list scrolls or rebuilds underneath a still pointer).
        if self.last_pointer is not None and abs(x - self.last_pointer[0]) + abs(y - self.last_pointer[1]) < 2:
            return
        first = self.last_pointer is None
        self.last_pointer = (x, y)
        if first:
            return
        ok, point = self.scroller.compute_point(self.listbox, _point(x, y))
        if ok:
            row = self.listbox.get_row_at_y(int(point.y))
            if row in self.rows and self.rows.index(row) != self.sel:
                self.sel = self.rows.index(row)
                self.listbox.select_row(row)
                self.schedule_preview()

    def on_key(self, _ctrl, keyval, _code, state):
        ctrl = bool(state & Gdk.ModifierType.CONTROL_MASK)
        alt = bool(state & Gdk.ModifierType.ALT_MASK)
        shift = bool(state & Gdk.ModifierType.SHIFT_MASK)
        key = Gdk.keyval_name(Gdk.keyval_to_lower(keyval)) or ""

        back_tab = key == "ISO_Left_Tab" or (key == "Tab" and shift)

        if self.footer_sel >= 0:
            if back_tab or key == "Escape":
                self.leave_footer()
                return True
            if key == "Tab" or key == "Down" or (ctrl and key in ("j", "n")):
                self.focus_footer(self.footer_sel + 1)
                return True
            if key == "Up" or (ctrl and key in ("k", "p")):
                self.focus_footer(self.footer_sel - 1)
                return True
            if key in ("Return", "KP_Enter", "space"):
                action = self.footer_rows[self.footer_sel].action
                self.leave_footer()
                action()
                return True
            # Anything else (typing, shortcuts) goes back to the list as usual.
            self.leave_footer()

        if back_tab:
            pass  # already in the list
        elif key == "Tab":
            self.focus_footer(0)
        elif key == "Escape":
            if self.search.get_text():
                self.search.set_text("")
            else:
                self.close_popup()
        elif key == "Down" or (ctrl and key in ("j", "n")):
            self.select(self.sel + 1)
        elif key == "Up" or (ctrl and key in ("k", "p")):
            self.select(self.sel - 1)
        elif key == "Page_Down":
            self.select(self.sel + 10)
        elif key == "Page_Up":
            self.select(self.sel - 10)
        elif key in ("Return", "KP_Enter"):
            self.choose(self.selected_item(), invert=shift)
        elif ctrl and len(key) == 1 and key in "123456789":
            history = [r.item for r in self.rows if not r.item.get("pinned")]
            n = int(key) - 1
            if n < len(history):
                self.choose(history[n])
        elif alt and key == "p":
            self.toggle_pin(self.selected_item())
        elif alt and key in ("Delete", "BackSpace"):
            self.remove(self.selected_item())
        elif alt and len(key) == 1 and key in PIN_KEYS:
            item = next((r.item for r in self.rows if r.item.get("pin_key") == key), None)
            if item:
                self.choose(item, invert=shift)
        elif ctrl and shift and key == "BackSpace":
            self.clear_history()
        elif ctrl and key == "comma":
            self.open_settings()
        elif ctrl and key == "q":
            self.app.quit()
        else:
            if not self.search.has_focus():
                self.search.grab_focus()
            return False
        return True


# -------------------------------------------------------- settings window ---

class SettingsWindow(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="omaccy Settings", default_width=520, resizable=False)
        self.app = app
        self.settings = app.settings
        self.add_css_class("omaccy-settings")
        self.return_to_popup = False
        self.connect("close-request", self.on_close)

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", lambda _c, kv, _k, _s: kv == Gdk.KEY_Escape and (self.close() or True))
        self.add_controller(keys)

        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        page.add_css_class("settings")
        self.set_child(page)
        title = Gtk.Label(label="omaccy", xalign=0)
        title.add_css_class("title")
        page.append(title)

        page.append(self._group([
            self._spin("History size", "Unpinned items to keep", "history_size", 10, 1000, 10),
            self._switch("Paste automatically", "Enter pastes into the previous window; Shift+Enter only copies",
                         "paste_automatically"),
            self._switch("Save images", "Keep copied images (screenshots, pictures) in history", "save_images"),
        ]))
        page.append(self._group([
            self._choice("Pinned items", "Where favourites sit in the list", "pinned_position",
                         [("top", "Top"), ("bottom", "Bottom")]),
            self._switch("Show preview", "Full text or image beside the list", "show_preview"),
            self._spin("Preview delay", "Milliseconds before the preview appears", "preview_delay", 0, 5000, 100),
        ]))

        hint = Gtk.Label(xalign=0, wrap=True, label="Open with SUPER + SHIFT + V (change it in ~/.config/hypr/bindings.lua). "
                         f"Settings are stored in {CONFIG_PATH.replace(os.path.expanduser('~'), '~')}.")
        hint.add_css_class("hint")
        page.append(hint)

    def on_close(self, *_):
        self.set_visible(False)
        # Opened from the popup: closing (Esc or SUPER+W) goes back to the list.
        if self.return_to_popup:
            self.return_to_popup = False
            GLib.idle_add(lambda: self.app.popup.open() and False)
        return True

    def _group(self, rows):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.add_css_class("group")
        for n, row in enumerate(rows):
            if n:
                box.append(Gtk.Separator())
            box.append(row)
        return box

    def _row(self, title, subtitle, control):
        row = Gtk.Box(spacing=16)
        row.add_css_class("setting")
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True, valign=Gtk.Align.CENTER)
        text.append(Gtk.Label(label=title, xalign=0))
        sub = Gtk.Label(label=subtitle, xalign=0, wrap=True)
        sub.add_css_class("hint")
        text.append(sub)
        row.append(text)
        control.set_valign(Gtk.Align.CENTER)
        row.append(control)
        return row

    def _switch(self, title, subtitle, key):
        switch = Gtk.Switch(active=getattr(self.settings, key))
        switch.connect("notify::active", lambda s, _p: self.app.change_setting(key, s.get_active()))
        return self._row(title, subtitle, switch)

    def _spin(self, title, subtitle, key, lo, hi, step):
        spin = Gtk.SpinButton.new_with_range(lo, hi, step)
        spin.set_value(getattr(self.settings, key))
        spin.connect("value-changed", lambda s: self.app.change_setting(key, s.get_value_as_int()))
        return self._row(title, subtitle, spin)

    def _choice(self, title, subtitle, key, options):
        dropdown = Gtk.DropDown.new_from_strings([label for _, label in options])
        values = [value for value, _ in options]
        current = getattr(self.settings, key)
        dropdown.set_selected(values.index(current) if current in values else 0)
        dropdown.connect("notify::selected",
                         lambda d, _p: self.app.change_setting(key, values[d.get_selected()]))
        return self._row(title, subtitle, dropdown)


# -------------------------------------------------------------- the app ---

class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.settings = Settings(CONFIG_PATH)
        self.store = None
        self.popup = None
        self.settings_window = None
        self.watcher = None

    def do_startup(self):
        Gtk.Application.do_startup(self)
        self.hold()
        self.theme = Theme()
        self.theme.apply()
        self.store = Store(HISTORY_PATH, self.settings)
        self.popup = Popup(self)
        if not PREVIEW_THEME:
            self.start_watcher()

    def do_command_line(self, cmdline):
        args = cmdline.get_arguments()[1:]
        command = args[0] if args else "daemon"
        if command == "toggle":
            self.popup.toggle()
        elif command == "show":
            self.popup.open()
        elif command == "settings":
            self.open_settings()
        elif command == "quit":
            self.quit()
        elif command != "daemon":
            cmdline.printerr(__doc__)
            return 1
        return 0

    def open_settings(self, from_popup=False):
        self.theme.apply()
        if self.settings_window is None:
            self.settings_window = SettingsWindow(self)
        self.settings_window.return_to_popup = from_popup
        self.settings_window.present()

    def change_setting(self, key, value):
        self.settings.set(key, value)
        if key == "history_size":
            self.store.trim()
            self.store.save()

    # -- clipboard watching -------------------------------------------------

    def start_watcher(self):
        # wl-paste runs the command on every selection change; we just need
        # the signal (and the state, so sensitive/cleared selections are skipped).
        argv = ["wl-paste", "--watch", "sh", "-c", 'echo "${CLIPBOARD_STATE:-data}"']
        try:
            self.watcher = Gio.Subprocess.new(argv, Gio.SubprocessFlags.STDOUT_PIPE)
        except GLib.Error as e:
            print(f"omaccy: cannot start wl-paste: {e.message}", file=sys.stderr)
            GLib.timeout_add_seconds(5, self._restart_watcher)
            return
        stream = Gio.DataInputStream.new(self.watcher.get_stdout_pipe())
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self._on_watch_line)

    def _restart_watcher(self):
        self.start_watcher()
        return False

    def _on_watch_line(self, stream, result):
        try:
            line, _ = stream.read_line_finish_utf8(result)
        except GLib.Error:
            line = None
        if line is None:  # wl-paste exited; bring it back
            GLib.timeout_add_seconds(1, self._restart_watcher)
            return
        if line.strip() == "data":
            run_async(["timeout", "2", "wl-paste", "--list-types"], self._on_types)
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self._on_watch_line)

    def _on_types(self, data):
        if data is None:
            return
        types = data.decode("utf-8", errors="replace").splitlines()
        if "x-kde-passwordManagerHint" in types:
            return
        if any(t.startswith("text/plain") or t in TEXT_MIMES for t in types):
            run_async(["timeout", "2", "wl-paste", "--no-newline", "--type", "text"],
                      lambda d: self._with_app(lambda app: self._store_text(d, app)))
        elif self.settings.save_images:
            mime = next((m for m in IMAGE_MIMES if m in types), None)
            if mime:
                run_async(["timeout", "5", "wl-paste", "--type", mime],
                          lambda d: self._with_app(lambda app: self._store_image(d, mime, app)))

    def _with_app(self, then):
        """Look up the focused window's class (the app the copy came from)."""
        def got(data):
            try:
                window = json.loads(data or b"{}")
                app = window.get("class") or window.get("initialClass")
            except ValueError:
                app = None
            then(app)
        run_async(["hyprctl", "activewindow", "-j"], got)

    def _store_text(self, data, app):
        if not data or len(data) > MAX_TEXT_BYTES:
            return
        text = data.decode("utf-8", errors="replace")
        if text.strip():
            self._stored(lambda: self.store.add_text(text, app))

    def _store_image(self, data, mime, app):
        if data and len(data) <= MAX_IMAGE_BYTES:
            self._stored(lambda: self.store.add_image(data, mime, app))

    def _stored(self, add):
        selected = self.popup.selected_item()
        add()
        if self.popup.get_visible():
            self.popup.refresh(keep_item=selected)

    def do_shutdown(self):
        if self.watcher:
            self.watcher.force_exit()
        Gtk.Application.do_shutdown(self)


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
